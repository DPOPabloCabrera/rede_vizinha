# PostgreSQL local — ajuste usuário, senha e endereço conforme sua instalação.
DATABASE_URL=postgres://postgres:troque-esta-senha@localhost:5432/rede_vizinha
DB_SSL=false
DB_POOL_MAX=10

# API
PORT=8080
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8765,http://localhost:8765
CONDOMINIO_CODIGO=FLEX-OSASCO-2
FRONTEND_URL=http://127.0.0.1:8765/cadastro.html

# SMTP para envio dos links. Em desenvolvimento local sem SMTP, o link aparece no terminal da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Rede Vizinha <no-reply@example.com>
PASSWORD_RESET_DEV_LINKS=true

# Gere uma chave aleatória exclusiva antes de iniciar (mínimo de 32 caracteres).
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
JWT_EXPIRES_IN=8h

# Segredo de uso único para criar o primeiro administrador pelo endpoint bootstrap.
ADMIN_BOOTSTRAP_TOKEN=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO
